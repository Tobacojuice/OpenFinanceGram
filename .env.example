# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================

# Supabase Configuration (Optional - for authentication & database)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ================================
# BACKEND ENVIRONMENT VARIABLES
# ================================

# FRED API Key (Required for economic data)
# Get your free API key at: https://fred.stlouisfed.org
FRED_API_KEY=your_fred_api_key_here

# OpenBB MCP Server Configuration
OPENBB_MCP_NAME=OpenBB Terminal
OPENBB_MCP_DESCRIPTION=Financial data terminal powered by OpenBB Platform
OPENBB_MCP_API_PREFIX=/api/v1
OPENBB_MCP_VERSION=1.0.0

# Tool Categories (comma-separated)
OPENBB_MCP_DEFAULT_TOOL_CATEGORIES=all
# OPENBB_MCP_ALLOWED_TOOL_CATEGORIES=equity,crypto,economy

# Server Configuration
OPENBB_MCP_ENABLE_TOOL_DISCOVERY=true
OPENBB_MCP_DESCRIBE_RESPONSES=false
OPENBB_MCP_CACHE_EXPIRATION_SECONDS=3600

# Uvicorn Server (HTTP Transport)
# Format: JSON string
OPENBB_MCP_UVICORN_CONFIG={"host": "127.0.0.1", "port": 8001}

# Authentication (Optional)
# Format: JSON array ["username", "password"]
# OPENBB_MCP_CLIENT_AUTH=["user", "pass"]
# OPENBB_MCP_SERVER_AUTH=["user", "pass"]

# Advanced Options
OPENBB_MCP_ON_DUPLICATE_TOOLS=warn
OPENBB_MCP_ON_DUPLICATE_RESOURCES=warn
OPENBB_MCP_MASK_ERROR_DETAILS=false
OPENBB_MCP_DEPRECATION_WARNINGS=false
